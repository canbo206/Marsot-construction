# Apache config for Hostinger (shared hosting). Vite copies this file from
# public/ into dist/ on build, so it must be uploaded along with everything
# else in dist/ — it is easy to miss because the leading dot hides it in
# some file managers.

# --- SPA routing (the important part) ---------------------------------------
# This is a single-page app: the server only really has index.html. Without
# the rule below, opening /about or /services/drywall directly (or hitting
# refresh on one) returns a 404, because Apache looks for a folder of that
# name on disk. Those URLs are also listed in sitemap.xml, so crawlers WILL
# request them directly. Send anything that isn't a real file to index.html
# and let react-router handle the route.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Redirects from the old Hostinger Website Builder site ---------------
  # marsotconstruction.com used to run a page-builder site whose URLs don't
  # match this one. These 301s keep old bookmarks, business cards, and any
  # search results from landing on a 404. /gallery needs no rule — the path
  # happens to be identical on both sites.
  # These MUST stay above the SPA fallback below, or the fallback swallows
  # them and the redirect never fires.
  # NE (noescape) is required: without it Apache turns the "#" into "%23"
  # and the anchor breaks.
  RewriteRule ^interior-painting-exterior-painting-drywall-services/?$ /#services [R=301,NE,L]
  RewriteRule ^seattle-painting-drywall-contractor-contact/?$ /#contact [R=301,NE,L]

  # Leave real files and folders alone (assets, favicon, robots.txt...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Compression ------------------------------------------------------------
# Wrapped in IfModule so the site still loads if the module is unavailable.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caching ----------------------------------------------------------------
# Vite fingerprints asset filenames (index-a1b2c3.js), so those are safe to
# cache for a long time. index.html must NOT be cached, or visitors keep
# getting the old page after the next upload.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
